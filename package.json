{
  "name": "emby-task-center",
  "version": "1.0.3",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "release:ghcr": "node scripts/release-ghcr.mjs",
    "build": "pnpm --filter @emby-task-center/web build && pnpm build:server",
    "build:server": "node scripts/build-server.mjs",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "smoke:zero-env": "node scripts/smoke-zero-env.mjs",
    "start": "node --env-file-if-exists=.env scripts/start-production.mjs",
    "test": "vitest run && pnpm --filter @emby-task-center/web test",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "tsc --noEmit --project tsconfig.base.json && pnpm --filter @emby-task-center/web typecheck"
  },
  "dependencies": {
    "@emby-task-center/contracts": "workspace:*",
    "@emby-task-center/database": "workspace:*",
    "@emby-task-center/task-domain": "workspace:*",
    "bencode": "^4.0.1",
    "better-sqlite3": "^13.0.3",
    "bittorrent-dht": "^11.0.12",
    "bittorrent-protocol": "^5.0.9",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "nodemailer": "^9.0.5",
    "redis": "^6.2.1",
    "ut_metadata": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hellohongyun/emby-task-center.git"
  }
}
